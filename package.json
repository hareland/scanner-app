{
  "name": "scanner-app",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "ios:sync": "nuxt generate && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "nuxt generate && cap sync ios && cap run ios",
    "clean": "rm -rf node_modules .nuxt .output capacitor.config.json ios/App/App/public"
  },
  "dependencies": {
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-navigation": "^8.16.0",
    "@frigear-nu/ui": "^0.2.0",
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/material-symbols": "^1.2.97",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^13.9.0",
    "jsbarcode": "^3.12.3",
    "konsta": "^5.5.0",
    "nuxt": "^4.6.3",
    "nuxt-capacitor": "^0.3.3",
    "nuxt-qrcode": "^0.4.10",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
